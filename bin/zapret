#!/usr/bin/env bash
set -euo pipefail

# 1. System-wide installed location
if [ -f "/opt/zapret-discord-youtube/current/service.sh" ]; then
    exec /opt/zapret-discord-youtube/current/service.sh "$@"
fi

# 2. Relative to script directory (when installed alongside repo)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [ -f "$SCRIPT_DIR/service.sh" ]; then
    exec "$SCRIPT_DIR/service.sh" "$@"
fi

# 3. Known user repository path
if [ -f "$HOME/Документы/zapret-discord-youtube-linux/service.sh" ]; then
    exec "$HOME/Документы/zapret-discord-youtube-linux/service.sh" "$@"
fi

echo "Ошибка: не удалось найти установленный zapret или репозиторий с service.sh" >&2
exit 1
