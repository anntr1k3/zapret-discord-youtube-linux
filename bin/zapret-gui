#!/usr/bin/env bash
set -euo pipefail

# 1. Permanent application, independent of the service
if [ -f "/usr/lib/zapret-discord-youtube/gui.py" ]; then
    exec /usr/bin/python3 /usr/lib/zapret-discord-youtube/gui.py "$@"
fi

# 2. Relative to script directory (when installed alongside repo)
SCRIPT_PATH="$(realpath -- "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(dirname "$(dirname "$SCRIPT_PATH")")"
if [ -f "$SCRIPT_DIR/gui.py" ]; then
    exec /usr/bin/python3 "$SCRIPT_DIR/gui.py" "$@"
fi

# 3. Default install.sh checkout, then compatibility with older launchers
if [ -f "$HOME/zapret-discord-youtube-linux/gui.py" ]; then
    exec /usr/bin/python3 "$HOME/zapret-discord-youtube-linux/gui.py" "$@"
fi
if [ -f "$HOME/Документы/zapret-discord-youtube-linux/gui.py" ]; then
    exec /usr/bin/python3 "$HOME/Документы/zapret-discord-youtube-linux/gui.py" "$@"
fi

echo "Ошибка: не удалось найти установленный zapret или репозиторий с gui.py" >&2
exit 1
